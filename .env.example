# Postgres (app metadata)
POSTGRES_URL=postgresql+psycopg://semexp:semexp@localhost:5432/semexp

# DuckDB (OLAP)
DUCKDB_PATH=./data/semexp.duckdb

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5050
MLFLOW_EXPERIMENT=semexp

# LLM via LiteLLM. Pick ONE.
# Local (default): requires Ollama running on :11434 with model pulled
LITELLM_MODEL=ollama/qwen2.5:3b
LITELLM_API_BASE=http://localhost:11434

# OpenAI:
# LITELLM_MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=sk-...

# Anthropic:
# LITELLM_MODEL=anthropic/claude-haiku-4-5
# ANTHROPIC_API_KEY=sk-ant-...

# Gemini:
# LITELLM_MODEL=gemini/gemini-1.5-flash
# GEMINI_API_KEY=...

# App
CORS_ORIGINS=["http://localhost:5173"]
SEED_DEFAULT_DATASET=true
DEFAULT_DATASET_NAME=default_entities
DEFAULT_DATASET_SIZE=1500
